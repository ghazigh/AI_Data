{
  "projectId": "13976d23-981a-4395-bcb7-8de96b770cc8",
  "shape": "package",
  "pkg": "@datalith/ui",
  "globalName": "DatalithUI",
  "buildCmd": "npm run build --prefix design-system",
  "cssEntry": "dist/styles.css",
  "extraFonts": ["dist/fonts/fonts.css"],
  "readmeHeader": ".design-sync/conventions.md",
  "componentSrcMap": { "FAQ": "src/components/FAQ.tsx" },
