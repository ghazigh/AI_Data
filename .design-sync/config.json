    "Navbar": { "cardMode": "column" },
    "Hero": { "cardMode": "column" },
    "LogoStrip": { "cardMode": "column" },
    "FeatureGrid": { "cardMode": "column" },
    "StatBand": { "cardMode": "column" },
    "Steps": { "cardMode": "column" },
    "Quote": { "cardMode": "column" },
    "PricingTable": { "cardMode": "column" },
    "FAQ": { "cardMode": "column" },
    "CTABand": { "cardMode": "column" },
    "Footer": { "cardMode": "column" }
  }
}
