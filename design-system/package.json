{
  "name": "@datalith/ui",
  "version": "0.1.0",
  "description": "Datalith Confluence design system — every source, one graph, agent-ready.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "fonts": "node scripts/fetch-fonts.mjs",
    "build": "tsup && node scripts/copy-assets.mjs",
    "build:landing": "node scripts/build-landing.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "build:all": "npm run build:site && npm run build:demo",
    "build:og": "node scripts/build-og.mjs",
    "shoot:demo": "node scripts/shoot-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "node scripts/serve.mjs"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "jsdom": "^24.1.0",
    "playwright-core": "^1.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.27.0",
    "three": "^0.169.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
